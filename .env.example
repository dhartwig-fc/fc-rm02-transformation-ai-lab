# Copy to .env (scripts/lab.sh init does this and generates the secret).
# .env is git-ignored. Never commit it.

# --- Pinned versions (bump deliberately; log in docs/licences.md) ---
OLLAMA_VERSION=0.40.13
OPEN_WEBUI_VERSION=v0.9.4

# --- Ports (always bound to 127.0.0.1) ---
OLLAMA_PORT=11434
OPEN_WEBUI_PORT=3000

# --- Where Open WebUI finds Ollama ---
# docker mode (Linux/WSL):  http://ollama:11434
# native mode (macOS):      http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434

# --- Models pulled by `scripts/lab.sh models` ---
# Chat model: pick to fit your RAM. Rough guide:
#   8 GB  -> qwen3:4b      16 GB -> qwen3:8b      32 GB+ -> qwen3:14b / gpt-oss:20b
LAB_CHAT_MODEL=qwen3:8b
LAB_EMBED_MODEL=nomic-embed-text

OLLAMA_KEEP_ALIVE=10m

# Set to false after you have created your admin account.
ENABLE_SIGNUP=true

# Generated by `scripts/lab.sh init`
WEBUI_SECRET_KEY=
